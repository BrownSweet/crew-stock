CREW_STOCK_PORT=8765
VITE_BASE_PATH=/crew/
mysql_ip=host.docker.internal
mysql_port=3306
mysql_root=crew_stock
mysql_password=REPLACE_WITH_MYSQL_PASSWORD
mysql_database=crew_stock
ALLOWED_HOSTS=tec.zhiquant.com
COOKIE_SECURE=true
# 填写外部 Nginx 到应用容器时的实际来源 IP；本机直连调试可用 127.0.0.1。
FORWARDED_ALLOW_IPS=127.0.0.1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LONGBRIDGE_REGION=global
